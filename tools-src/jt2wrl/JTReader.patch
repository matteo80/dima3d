diff --git a/JTReader/NodeElements/PartitionNodeData.cs b/JTReader/NodeElements/PartitionNodeData.cs
index bdc61c7..fbf4e0a 100644
--- a/JTReader/NodeElements/PartitionNodeData.cs
+++ b/JTReader/NodeElements/PartitionNodeData.cs
@@ -19,8 +19,24 @@ namespace DLAT.JTReader {
         public PartitionNodeData(Element ele) : base(ele) {
             var data = ele.dataStream;
 
-            if (ele.majorVersion == 10 && ele.minorVersion < 5) {
-                var localVersionFlag = data.ReadU8();
+            if (ele.majorVersion == 10) {
+                if (ele.minorVersion < 5) {
+                    data.ReadU8(); // versione
+                } else {
+                    // Alcuni JT 10.5+ (es. 10.6 da NX) hanno ancora il byte di versione:
+                    // lo si riconosce dalla lunghezza dei dati rimasti.
+                    var save = data.Position;
+                    var rem = data.Length - save;
+                    long need = -1;
+                    if (rem >= 8) {
+                        data.ReadI32();
+                        var n = data.ReadI32();
+                        if (n >= 0) need = 60 + 2L * n;
+                    }
+                    data.Position = save;
+                    if (rem != need && rem != need + 24)
+                        data.ReadU8(); // versione
+                }
             }
 
             partitionFlags = data.ReadI32();
